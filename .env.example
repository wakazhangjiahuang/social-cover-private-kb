# Server-only configuration. No model name is assumed; use one your provider actually supports.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
VISION_MODEL=
# Optional: a provider-supported size string. Final composition controls export dimensions.
IMAGE_SIZE=
IMAGE_PROVIDER=openai-compatible

# Optional independent text strategy endpoint. If absent, local rules are labelled honestly.
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=
# Standalone server. Loopback by default. Docker requires a private access password >=16 chars.
STUDIO_HOST=127.0.0.1
PORT=29012
STUDIO_ACCESS_TOKEN=
# Set when behind an HTTPS reverse proxy, e.g. https://studio.example.com (no trailing slash).
STUDIO_PUBLIC_ORIGIN=
