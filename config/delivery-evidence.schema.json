{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cover delivery evidence",
  "type": "object",
  "required": [
    "task",
    "stages",
    "files"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "BLOCKED",
          "NOT_RUN",
          "UNKNOWN",
          "NOT_APPLICABLE"
        ]
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "format": {
            "type": "string"
          },
          "ratio_exact": {
            "type": "boolean"
          },
          "decode_status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "zip": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "file_count": {
          "type": "integer"
        },
        "integrity": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    },
    "platform_preview": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    }
  }
}